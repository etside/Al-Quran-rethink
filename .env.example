# Miraz — Al-Quran Re-think
# Environment Variables Configuration

# Frontend (Vite)
# Base URL for the backend API. In development, leave empty (Vite proxy handles it).
# In production on Vercel, set to your backend deployment URL.
VITE_API_BASE=

# Backend (FastAPI)
# Comma-separated list of allowed CORS origins. Use * for development.
# In production, set to your frontend domain(s).
ALLOWED_ORIGINS=*

# Path to SQLite database file. Default: ../miraz.db relative to app/
MIRAZ_DB=../miraz.db

# Database URL for Phase 2 (PostgreSQL). Not implemented yet.
# DATABASE_URL=postgresql://user:password@localhost:5432/miraz
