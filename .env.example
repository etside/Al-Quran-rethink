# Miraz — single webapp
# Environment Variables Configuration

# Single origin: the UI and API are served from one server, so the frontend
# needs NO api base override. Leave empty (same-origin /api).
# Only set VITE_API_BASE if you deliberately split UI and API across hosts.
VITE_API_BASE=

# Backend (FastAPI)
# Comma-separated list of allowed CORS origins. Same-origin serving needs no
# CORS; set your public origin(s) in production, e.g. https://miraz.vercel.app
ALLOWED_ORIGINS=*

# Path to SQLite database file. Default: backend/miraz.db
MIRAZ_DB=../miraz.db

# Directory with the built React UI (index.html + assets). Resolution order:
# $MIRAZ_STATIC, then backend/static/ (Docker + Vercel builds),
# then frontend/dist/ (repo-local build). Unset = API-only mode.
# MIRAZ_STATIC=

# Server port (Docker / hosts). Default: 8000
# PORT=8000

# Database URL for Phase 2 (PostgreSQL). Not implemented yet.
# DATABASE_URL=postgresql://user:password@localhost:5432/miraz
